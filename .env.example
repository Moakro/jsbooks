# Cloudflare credentials (for wrangler / D1 / Pages deploys)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Obsidian vault root used by admin canonical-mapping tool.
# Defaults to "<repo>/content" when unset (vault root = repo content/).
VAULT_PATH=/home/<you>/Dev/svelte/jsbooks/content

# Kakao Maps JS SDK key (client-exposed). Used by the places map (public)
# and the admin coordinate-input map. The PUBLIC_ prefix is required so Astro
# exposes it to client-side code (import.meta.env.PUBLIC_KAKAO_JS_KEY).
# Issue at https://developers.kakao.com → register site domains
# (https://jsbooks.wiki, http://localhost:4321). For production set the same
# var in the Cloudflare Pages build environment. Build passes without it; the
# map area then shows a "key not set" notice instead of crashing.
PUBLIC_KAKAO_JS_KEY=
