---
/**
 * 절 anchor 옆에 노출하는 [URL 복사] 작은 버튼.
 *
 * 클릭 시 Base.astro 의 전역 핸들러가 `data-verse-copy` 를 잡아 현재 URL +
 * `#{anchor}` 을 clipboard 에 복사하고, Toast 컴포넌트에 안내 메시지를 띄운다.
 * 페이지 hash 는 변경하지 않는다 (스크롤 점프 없음).
 */
interface Props {
  /** 절 anchor (예: '1-6-1', '42', 'preface-3'). */
  anchor: string;
  /** 작게 표시할 라벨. 기본 'URL 복사'. */
  label?: string;
}
const { anchor, label = "URL 복사" } = Astro.props;
---

<button
  type="button"
  class="verse-copy-btn"
  data-verse-copy={anchor}
  aria-label={`${anchor} 절 URL 복사`}
  title="현재 구절의 URL 복사"
>{label}</button>

<style>
  .verse-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.04rem 0.45rem 0.06rem;
    background: transparent;
    border: 1px solid var(--color-rule, #e8dfd9);
    border-radius: 999px;
    color: var(--color-muted, #8a807a);
    font: inherit;
    font-size: 0.72rem;
    line-height: 1.3;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .verse-copy-btn:hover {
    color: var(--color-secondary, #1e6e6e);
    border-color: var(--color-secondary, #1e6e6e);
    background: var(--color-secondary-bg, #f0f7f6);
  }
</style>
