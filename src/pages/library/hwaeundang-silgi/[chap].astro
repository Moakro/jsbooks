---
import Base from "../../../layouts/Base.astro";
import History from "../../../components/History.astro";
import { getCollection } from "astro:content";
import { buildCardManifest } from "../../../lib/manifest";
import { renderWikilinks } from "../../../lib/wikilink";
import { parseVerseGroups } from "../../../lib/verse-parser";
import { correspondencesFor } from "../../../lib/correspondences";
import CorrespondenceBadges from "../../../components/CorrespondenceBadges.astro";
import ScriptureChapterNav from "../../../components/ScriptureChapterNav.astro";
import ScriptureStickyBar from "../../../components/ScriptureStickyBar.astro";

export async function getStaticPaths() {
  const all = await getCollection("scripture");
  return all
    .filter((e) => e.id.startsWith("hwaeundang-silgi/") && e.data.장)
    .map((e) => ({
      params: { chap: String(e.data.장) },
      props: { entry: e },
    }));
}

const { entry } = Astro.props;
const 장 = entry.data.장!;
const 장_이름 = entry.data.장_이름 ?? "";
const manifest = await buildCardManifest();

type Sentence = { anchor: string; html: string };
type Group = { num: number; oldAnchor: string; sentences: Sentence[] };

// 마이그 후: `## N절` 그룹 + 그룹별 문장 anchor (`^1-장-K`).
// 구 deeplink (`#장-N`) 호환을 위해 절 헤딩에 OLD anchor (`${장}-${N}`) 도 부여.
const groups: Group[] = parseVerseGroups(entry.body ?? "").map((g) => ({
  num: g.num,
  oldAnchor: `${장}-${g.num}`,
  sentences: g.sentences.map((s) => ({
    anchor: s.anchor,
    html: s.text
      .split(/\n\s*\n/)
      .filter(Boolean)
      .map((p) => renderWikilinks(p, manifest))
      .join("\n\n"),
  })),
}));

const all = await getCollection("scripture");
const sameScripture = all
  .filter((e) => e.id.startsWith("hwaeundang-silgi/") && e.data.장)
  .sort((a, b) => (a.data.장 ?? 0) - (b.data.장 ?? 0));
const idx = sameScripture.findIndex((e) => e.id === entry.id);
const totalChaps = sameScripture.length;
const chapPct = Math.round(((idx + 1) / totalChaps) * 100);

const historyPath = `content/scripture/${entry.id}.md`;
---

<Base
  title={`제${장}장 ${장_이름} — 화은당실기`}
  scriptureSlug="hwaeundang-silgi"
  chapterAnchor={String(장)}
  chapterLabel={`제${장}장 ${장_이름}`}
>
  <ScriptureStickyBar
    scriptureName="화은당실기"
    scriptureSlug="hwaeundang-silgi"
    scriptureHref="/library/hwaeundang-silgi/"
    context={`제${장}장 ${장_이름}`}
  />
  <div class="chap-head">
    <h1>제{장}장 {장_이름}</h1>
  </div>
  <div class="chap-progress" aria-label={`${idx + 1}번째 장 / 전체 ${totalChaps}장`}>
    <div class="bar"><div class="fill" style={`width: ${chapPct}%`}></div></div>
    <span class="meta">{idx + 1} / {totalChaps}장</span>
  </div>

  <div
    data-pagefind-body
    data-pagefind-filter="scripture:hwaeundang-silgi"
    data-pagefind-meta={`title:제${장}장 ${장_이름}`}
  >
    <span hidden data-pagefind-filter="kind:경전"></span>
    <span hidden data-pagefind-meta="scriptureName:화은당실기"></span>
    {groups.map((g) => (
      <section class="verse-group">
        <h3 class="group-heading" id={g.oldAnchor}>{g.num}절</h3>
        {g.sentences.map((s) => (
          <section class="verse" id={s.anchor} data-group-num={g.num}>
            <div class="verse-label" data-pagefind-ignore>
              <span class="verse-label-meta">
                <a href={`#${s.anchor}`}>^{s.anchor}</a>
                <CorrespondenceBadges matches={correspondencesFor("hwaeundang-silgi", s.anchor)} />
              </span>
            </div>
            <div class="verse-body" set:html={s.html} />
          </section>
        ))}
      </section>
    ))}
  </div>

  <ScriptureChapterNav scriptureSlug="hwaeundang-silgi" currentId={entry.id} />

  <History path={historyPath} />
</Base>

<style>
  .chap-head { display: flex; align-items: baseline; gap: 0.7rem; flex-wrap: wrap; }
  .chap-head h1 { margin: 0; }
  .chap-progress {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0.4rem 0 1.5rem;
  }
  .chap-progress .bar {
    flex: 1;
    height: 4px;
    background: var(--color-rule);
    border-radius: 999px;
    overflow: hidden;
  }
  .chap-progress .fill {
    height: 100%;
    background: var(--color-primary);
    border-radius: 999px;
    transition: width 0.3s ease;
  }
  .chap-progress .meta {
    font-size: 0.78rem;
    color: var(--color-muted);
    flex-shrink: 0;
  }
  .verse-group {
    margin-bottom: 1.5rem;
  }
  .group-heading {
    margin: 1.6rem 0 0.4rem;
    font-size: 1rem;
    color: var(--color-primary);
    font-weight: 600;
  }
  .verse-group:first-child .group-heading {
    margin-top: 0;
  }
  /* verse-label: 좌측 메타 + 우측 댓글 버튼 (천지개벽경 패턴) */
  .verse-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .verse-label-meta {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .verse-body :global(p) { margin: 0.5rem 0; }
</style>
