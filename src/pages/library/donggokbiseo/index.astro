---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { buildCardManifest } from "../../../lib/manifest";
import { renderWikilinks } from "../../../lib/wikilink";
import { parseVerseGroups } from "../../../lib/verse-parser";
import { correspondencesFor } from "../../../lib/correspondences";
import CorrespondenceBadges from "../../../components/CorrespondenceBadges.astro";
import ScriptureChapterNav from "../../../components/ScriptureChapterNav.astro";
import ScriptureStickyBar from "../../../components/ScriptureStickyBar.astro";
import ScriptureVersionTag from "../../../components/ScriptureVersionTag.astro";
import AiMatchNotice from "../../../components/AiMatchNotice.astro";

const all = await getCollection("scripture");
const verses_entry = all.find((e) => e.id === "donggokbiseo/01_본문");
if (!verses_entry) throw new Error("donggokbiseo/01_본문.md not found");

const manifest = await buildCardManifest();

type Sentence = { anchor: string; html: string };
type Group = { num: number; oldAnchor: string; sentences: Sentence[] };

// 마이그 후: `## N절` 그룹 + 그룹별 문장 anchor (`^1-1-K`).
// 구 deeplink (`#NNN`) 호환을 위해 절 헤딩에 OLD anchor (3-digit) 도 부여.
const groups: Group[] = parseVerseGroups(verses_entry.body ?? "").map((g) => ({
  num: g.num,
  oldAnchor: String(g.num).padStart(3, "0"),
  sentences: g.sentences.map((s) => ({
    anchor: s.anchor,
    html: s.text
      .split(/\n\s*\n/)
      .filter(Boolean)
      .map((p) => renderWikilinks(p, manifest))
      .join("\n\n"),
  })),
}));
---

<Base
  title="동곡비서 (銅谷秘書) — jsbooks"
  scriptureSlug="donggokbiseo"
  chapterAnchor="0"
  chapterLabel="동곡비서 본문"
>
  <ScriptureStickyBar
    scriptureName="동곡비서"
    scriptureSlug="donggokbiseo"
    context="본문"
  />
  <p class="meta"><a href="/library/">← 서재</a></p>
  <h1>동곡비서 (銅谷秘書)</h1>
  <p class="meta">이춘풍(李春風) 엮음 · 1990년 5월 5일 (경오년)</p>
  <ScriptureVersionTag slug="donggokbiseo" />

  <p class="meta" style="font-size: 0.9rem; margin-top: 0.5rem">
    본문 {groups.length}절. 권·장 위계 없이 평면 시퀀스로 수록되어 있습니다.
  </p>

  <ScriptureChapterNav scriptureSlug="donggokbiseo" currentId={verses_entry.id} placement="top" />

  <AiMatchNotice />

  <hr style="margin: 1.5rem 0; border: none; border-top: 1px solid var(--rule)" />

  <div
    data-pagefind-body
    data-pagefind-filter="scripture:donggokbiseo"
    data-pagefind-meta="title:동곡비서"
  >
    <span hidden data-pagefind-filter="kind:경전"></span>
    <span hidden data-pagefind-meta="scriptureName:동곡비서"></span>
    {groups.map((g) => (
      <section class="verse-group">
        <h3 class="group-heading" id={g.oldAnchor}>{g.num}절</h3>
        {g.sentences.map((s) => (
          <section class="verse" id={s.anchor} data-group-num={g.num}>
            <div class="verse-label" data-pagefind-ignore>
              <span class="verse-label-meta">
                <a href={`#${s.anchor}`}>^{s.anchor}</a>
                <CorrespondenceBadges matches={correspondencesFor("donggokbiseo", s.anchor)} />
              </span>
            </div>
            <div class="verse-body" set:html={s.html} />
          </section>
        ))}
      </section>
    ))}
  </div>

  <ScriptureChapterNav scriptureSlug="donggokbiseo" currentId={verses_entry.id} />
</Base>

<style>
  .verse-group {
    margin-bottom: 1.5rem;
  }
  .group-heading {
    margin: 1.6rem 0 0.4rem;
    font-size: 1rem;
    color: var(--color-primary);
    font-weight: 600;
  }
  .verse-group:first-child .group-heading {
    margin-top: 0;
  }
  .verse-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .verse-label-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .verse-label a {
    font-size: 0.8em;
    opacity: 0.55;
  }
</style>
