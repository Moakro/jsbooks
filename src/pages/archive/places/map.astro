---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";
import KakaoMap from "../../../components/KakaoMap.svelte";

const entries = await getCollection("places");

type MapPlace = {
  slug: string;
  name: string;
  name_hanja?: string;
  region?: string;
  coord: [number, number];
};

// 숫자 좌표를 가진 장소만 (coord: "none" · undefined 제외)
const mapPlaces: MapPlace[] = entries
  .filter((e) => Array.isArray(e.data.coord))
  .map((e) => ({
    slug: e.id,
    name: e.data.name ?? e.id,
    name_hanja: e.data.name_hanja,
    region: e.data.region,
    coord: e.data.coord as [number, number],
  }))
  .sort((a, b) => a.name.localeCompare(b.name, "ko"));
---

<Base title="장소 지도 — jsbooks">
  <p class="meta"><a href="/archive/places/">← 장소 목록</a></p>
  <h1>장소 지도</h1>
  <p class="meta">
    좌표가 입력된 장소 <strong>{mapPlaces.length}</strong>건. 핀을 클릭하면 해당 장소로 이동합니다.
  </p>

  {mapPlaces.length === 0 ? (
    <p class="empty">아직 좌표가 입력된 장소가 없습니다.</p>
  ) : (
    <KakaoMap client:only="svelte" mode="display" places={mapPlaces} height="70vh" />
  )}
</Base>

<style>
  h1 { margin: 0 0 0.4rem; }
  .meta { color: var(--color-muted); font-size: 0.9rem; margin: 0.2rem 0; }
  .meta a { color: var(--color-secondary); text-decoration: none; }
  .meta a:hover { text-decoration: underline; }
  .empty {
    color: var(--color-muted);
    padding: 2rem;
    text-align: center;
    border: 1px dashed var(--color-rule);
    border-radius: 6px;
  }
  h1 + .meta { margin-bottom: 1rem; }
</style>
