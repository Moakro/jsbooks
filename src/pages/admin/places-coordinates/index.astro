---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";
import AdminGate from "../../../components/AdminGate.astro";
import KakaoMap from "../../../components/KakaoMap.svelte";

const places = await getCollection("places");

type CoordKind = "num" | "none" | "missing";

type Row = {
  slug: string;
  name: string;
  nameHanja: string;
  region: string;
  status: string;
  coord: [number, number] | null;
  kind: CoordKind;
};

function coordKind(coord: unknown): CoordKind {
  if (Array.isArray(coord)) return "num";
  if (coord === "none") return "none";
  return "missing";
}

const rows: Row[] = places
  .map((e) => {
    const raw = e.data.coord;
    const kind = coordKind(raw);
    return {
      slug: e.id,
      name: e.data.name ?? e.id,
      nameHanja: e.data.name_hanja ?? "",
      region: e.data.region ?? "",
      status: e.data.status ?? "",
      coord: kind === "num" ? (raw as [number, number]) : null,
      kind,
    };
  })
  .sort((a, b) => a.name.localeCompare(b.name, "ko"));

const total = rows.length;
const withCoord = rows.filter((r) => r.kind === "num").length;
const noneCount = rows.filter((r) => r.kind === "none").length;
const missing = total - withCoord - noneCount;
---

<Base title="places coordinates — admin">
  <AdminGate>
    <h1>장소 좌표 입력</h1>
    <p class="meta">
      <code>content/places/*.md</code> frontmatter에 <code>coord: [lat, lng]</code> 추가.
      지도 클릭 또는 핀 드래그로 좌표가 자동 입력됩니다. 로컬 dev 모드에서만 저장됩니다.
    </p>

    <div class="summary">
      <div>전체 <strong>{total}</strong></div>
      <div>좌표 입력 <strong id="sum-num">{withCoord}</strong></div>
      <div>미입력 <strong id="sum-missing">{missing}</strong></div>
      <div>해당없음 <strong id="sum-none">{noneCount}</strong></div>
    </div>

    <div class="app">
      <aside class="list">
        <input id="q" class="search" type="search" placeholder="이름·한자·지역 검색" autocomplete="off" />
        <ul id="rows">
          {rows.map((r) => (
            <li
              class="row"
              data-slug={r.slug}
              data-name={r.name}
              data-hanja={r.nameHanja}
              data-region={r.region}
              data-status={r.status}
              data-kind={r.kind}
              data-lat={r.coord ? String(r.coord[0]) : ""}
              data-lng={r.coord ? String(r.coord[1]) : ""}
            >
              <button type="button" class="row-btn">
                <span class={`ind ind-${r.kind}`} aria-hidden="true">
                  {r.kind === "num" ? "✓" : r.kind === "none" ? "⊘" : "·"}
                </span>
                <span class="row-main">
                  <span class="row-name">{r.name}</span>
                  {r.nameHanja && <span class="row-hanja">{r.nameHanja}</span>}
                </span>
                <span class="row-region">{r.region}</span>
              </button>
            </li>
          ))}
        </ul>
      </aside>

      <section class="detail" id="detail">
        <p class="empty" id="empty">왼쪽 목록에서 장소를 선택하세요.</p>
        <div class="card" id="card" hidden>
          <header class="card-head">
            <h2 id="d-name">—</h2>
            <p class="card-meta">
              <span id="d-hanja"></span>
              <span class="dot" id="d-dot1" hidden>·</span>
              <span id="d-region"></span>
              <span class="dot" id="d-dot2" hidden>·</span>
              <span id="d-status" class="status"></span>
            </p>
          </header>

          <div class="current">
            <span class="label">현재 좌표</span>
            <span id="d-current" class="value">—</span>
          </div>

          <div class="map-wrap">
            <KakaoMap client:only="svelte" mode="input" height="340px" />
            <p class="map-hint">지도를 클릭하거나 핀을 드래그하면 아래 좌표가 채워집니다.</p>
          </div>

          <div class="inputs">
            <label class="field">
              <span>위도 (lat)</span>
              <input id="lat" type="number" step="0.000001" min="-90" max="90" placeholder="예: 35.586200" />
            </label>
            <label class="field">
              <span>경도 (lng)</span>
              <input id="lng" type="number" step="0.000001" min="-180" max="180" placeholder="예: 126.679100" />
            </label>
          </div>

          <label class="field paste-field">
            <span>좌표 붙여넣기 (구글맵 등 <code>lat, lng</code> 통째로)</span>
            <input id="paste" type="text" placeholder="예: 35.586200, 126.679100" autocomplete="off" />
          </label>

          <div class="actions">
            <button type="button" id="save" class="btn primary">저장</button>
            <button type="button" id="save-none" class="btn">좌표 없음(광역/추상)</button>
            <button type="button" id="remove" class="btn ghost" hidden>좌표 삭제</button>
            <span id="status-msg" class="status-msg" role="status"></span>
          </div>

          <div class="search-links">
            <span class="label">좌표 찾기 보조:</span>
            <a id="link-kakao" href="#" target="_blank" rel="noopener noreferrer">카카오맵</a>
            <a id="link-google" href="#" target="_blank" rel="noopener noreferrer">구글맵</a>
            <a id="link-osm" href="#" target="_blank" rel="noopener noreferrer" hidden>OpenStreetMap (현재 좌표)</a>
          </div>
        </div>
      </section>
    </div>
  </AdminGate>
</Base>

<script>
  // 좌측 검색 필터
  const search = document.getElementById("q") as HTMLInputElement;
  const rowsEl = document.getElementById("rows") as HTMLUListElement;
  const rows = Array.from(rowsEl.querySelectorAll<HTMLLIElement>(".row"));

  function applyFilter() {
    const q = search.value.trim().toLowerCase();
    for (const r of rows) {
      if (!q) {
        r.hidden = false;
        continue;
      }
      const hay = [
        r.dataset.name ?? "",
        r.dataset.hanja ?? "",
        r.dataset.region ?? "",
      ].join(" ").toLowerCase();
      r.hidden = !hay.includes(q);
    }
  }
  search.addEventListener("input", applyFilter);

  // 요소 참조
  const empty = document.getElementById("empty")!;
  const card = document.getElementById("card") as HTMLDivElement;
  const dName = document.getElementById("d-name")!;
  const dHanja = document.getElementById("d-hanja")!;
  const dRegion = document.getElementById("d-region")!;
  const dStatus = document.getElementById("d-status")!;
  const dDot1 = document.getElementById("d-dot1") as HTMLElement;
  const dDot2 = document.getElementById("d-dot2") as HTMLElement;
  const dCurrent = document.getElementById("d-current")!;
  const latInput = document.getElementById("lat") as HTMLInputElement;
  const lngInput = document.getElementById("lng") as HTMLInputElement;
  const pasteInput = document.getElementById("paste") as HTMLInputElement;
  const saveBtn = document.getElementById("save") as HTMLButtonElement;
  const saveNoneBtn = document.getElementById("save-none") as HTMLButtonElement;
  const removeBtn = document.getElementById("remove") as HTMLButtonElement;
  const statusMsg = document.getElementById("status-msg")!;
  const linkKakao = document.getElementById("link-kakao") as HTMLAnchorElement;
  const linkGoogle = document.getElementById("link-google") as HTMLAnchorElement;
  const linkOsm = document.getElementById("link-osm") as HTMLAnchorElement;

  // 요약 카운트
  const sumNum = document.getElementById("sum-num")!;
  const sumMissing = document.getElementById("sum-missing")!;
  const sumNone = document.getElementById("sum-none")!;

  function recountSummary() {
    let num = 0, none = 0, missing = 0;
    for (const r of rows) {
      const k = r.dataset.kind;
      if (k === "num") num++;
      else if (k === "none") none++;
      else missing++;
    }
    sumNum.textContent = String(num);
    sumMissing.textContent = String(missing);
    sumNone.textContent = String(none);
  }

  let selectedRow: HTMLLIElement | null = null;

  // 섬(지도)에게 중심 이동/마커 표시 요청
  function mapGoto(lat: number | null, lng: number | null) {
    if (lat == null || lng == null) {
      window.dispatchEvent(new CustomEvent("jsbooks:map-goto", { detail: { clear: true } }));
    } else {
      window.dispatchEvent(
        new CustomEvent("jsbooks:map-goto", { detail: { lat, lng, recenterLevel: 4 } }),
      );
    }
  }

  function selectRow(row: HTMLLIElement) {
    if (selectedRow) selectedRow.classList.remove("selected");
    selectedRow = row;
    row.classList.add("selected");

    const name = row.dataset.name ?? "";
    const hanja = row.dataset.hanja ?? "";
    const region = row.dataset.region ?? "";
    const status = row.dataset.status ?? "";
    const kind = row.dataset.kind ?? "missing";
    const lat = row.dataset.lat ? Number(row.dataset.lat) : null;
    const lng = row.dataset.lng ? Number(row.dataset.lng) : null;

    empty.hidden = true;
    card.hidden = false;
    dName.textContent = name;
    dHanja.textContent = hanja;
    dRegion.textContent = region;
    dStatus.textContent = status;
    dDot1.hidden = !(hanja && (region || status));
    dDot2.hidden = !(region && status);
    pasteInput.value = "";

    if (kind === "num" && lat != null && lng != null) {
      dCurrent.textContent = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
      latInput.value = String(lat);
      lngInput.value = String(lng);
      removeBtn.hidden = false;
      linkOsm.hidden = false;
      linkOsm.href = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=15/${lat}/${lng}`;
      mapGoto(lat, lng);
    } else if (kind === "none") {
      dCurrent.textContent = "해당없음 (광역/추상)";
      latInput.value = "";
      lngInput.value = "";
      removeBtn.hidden = false;
      linkOsm.hidden = true;
      mapGoto(null, null);
    } else {
      dCurrent.textContent = "— (미입력)";
      latInput.value = "";
      lngInput.value = "";
      removeBtn.hidden = true;
      linkOsm.hidden = true;
      mapGoto(null, null);
    }

    const q = encodeURIComponent([name, region].filter(Boolean).join(" "));
    linkKakao.href = `https://map.kakao.com/?q=${q}`;
    linkGoogle.href = `https://www.google.com/maps/search/?api=1&query=${q}`;
    statusMsg.textContent = "";
    statusMsg.className = "status-msg";
  }

  rowsEl.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest(".row-btn");
    if (!btn) return;
    const row = btn.closest(".row") as HTMLLIElement | null;
    if (!row) return;
    selectRow(row);
  });

  function setStatus(msg: string, kind: "ok" | "err" | "" = "") {
    statusMsg.textContent = msg;
    statusMsg.className = "status-msg" + (kind ? " " + kind : "");
  }

  // 섬(지도) → 폼: 클릭/드래그로 고른 좌표 채우기
  window.addEventListener("jsbooks:coord-pick", (e) => {
    const d = (e as CustomEvent).detail ?? {};
    const lat = Number(d.lat);
    const lng = Number(d.lng);
    if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;
    latInput.value = lat.toFixed(6);
    lngInput.value = lng.toFixed(6);
    dCurrent.textContent = `${lat.toFixed(6)}, ${lng.toFixed(6)} (미저장)`;
    setStatus("좌표를 지도에서 선택했습니다. 저장하세요.", "");
  });

  // 좌표 통째 붙여넣기 분리: "35.5862, 126.6791" / "(35.5862, 126.6791)" 등
  function parsePastedCoord(text: string): { lat: number; lng: number } | null {
    const cleaned = text.replace(/[()]/g, " ").trim();
    const parts = cleaned.split(/[,\s]+/).filter(Boolean);
    if (parts.length < 2) return null;
    const lat = Number(parts[0]);
    const lng = Number(parts[1]);
    if (!Number.isFinite(lat) || !Number.isFinite(lng)) return null;
    if (lat < -90 || lat > 90 || lng < -180 || lng > 180) return null;
    return { lat, lng };
  }

  function applyPasted(text: string): boolean {
    const r = parsePastedCoord(text);
    if (!r) return false;
    latInput.value = r.lat.toFixed(6);
    lngInput.value = r.lng.toFixed(6);
    dCurrent.textContent = `${r.lat.toFixed(6)}, ${r.lng.toFixed(6)} (미저장)`;
    mapGoto(r.lat, r.lng);
    setStatus("붙여넣은 좌표를 분리했습니다. 저장하세요.", "");
    return true;
  }

  // 전용 붙여넣기 칸 + lat 칸 둘 다에서 동작
  pasteInput.addEventListener("paste", (e) => {
    const text = e.clipboardData?.getData("text") ?? "";
    if (applyPasted(text)) {
      e.preventDefault();
      pasteInput.value = "";
    }
  });
  pasteInput.addEventListener("input", () => {
    if (pasteInput.value.includes(",")) {
      if (applyPasted(pasteInput.value)) pasteInput.value = "";
    }
  });
  latInput.addEventListener("paste", (e) => {
    const text = e.clipboardData?.getData("text") ?? "";
    if (text.includes(",") && applyPasted(text)) e.preventDefault();
  });

  function updateRowAfterSave(row: HTMLLIElement, lat: number, lng: number) {
    row.dataset.lat = String(lat);
    row.dataset.lng = String(lng);
    row.dataset.kind = "num";
    setInd(row, "num");
  }

  function updateRowAfterNone(row: HTMLLIElement) {
    row.dataset.lat = "";
    row.dataset.lng = "";
    row.dataset.kind = "none";
    setInd(row, "none");
  }

  function updateRowAfterDelete(row: HTMLLIElement) {
    row.dataset.lat = "";
    row.dataset.lng = "";
    row.dataset.kind = "missing";
    setInd(row, "missing");
  }

  function setInd(row: HTMLLIElement, kind: "num" | "none" | "missing") {
    const ind = row.querySelector(".ind");
    if (!ind) return;
    ind.textContent = kind === "num" ? "✓" : kind === "none" ? "⊘" : "·";
    ind.className = `ind ind-${kind}`;
  }

  // 다음 미입력(missing) 장소로 자동 이동
  function advanceToNextMissing(fromRow: HTMLLIElement) {
    const idx = rows.indexOf(fromRow);
    // fromRow 다음부터 끝까지, 그다음 처음부터 fromRow까지 순회
    const order = [...rows.slice(idx + 1), ...rows.slice(0, idx)];
    const next = order.find((r) => r.dataset.kind !== "num" && r.dataset.kind !== "none");
    if (next) {
      // 검색 필터로 숨겨져 있으면 보이게
      if (next.hidden) { search.value = ""; applyFilter(); }
      next.scrollIntoView({ block: "nearest" });
      selectRow(next);
      setStatus("다음 미입력 장소로 이동했습니다.", "ok");
    } else {
      setStatus("모든 장소 입력이 완료되었습니다. 🎉", "ok");
    }
  }

  saveBtn.addEventListener("click", async () => {
    if (!selectedRow) return;
    const slug = selectedRow.dataset.slug!;
    const lat = Number(latInput.value);
    const lng = Number(lngInput.value);
    if (!Number.isFinite(lat) || lat < -90 || lat > 90) {
      setStatus("위도(lat)는 -90 ~ 90 사이 숫자여야 합니다.", "err");
      return;
    }
    if (!Number.isFinite(lng) || lng < -180 || lng > 180) {
      setStatus("경도(lng)는 -180 ~ 180 사이 숫자여야 합니다.", "err");
      return;
    }
    setStatus("저장 중…");
    saveBtn.disabled = true;
    try {
      const res = await fetch("/api/admin/places-coordinates/save", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ slug, lat, lng }),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data?.error ?? `HTTP ${res.status}`);
      const savedRow = selectedRow;
      updateRowAfterSave(savedRow, lat, lng);
      recountSummary();
      advanceToNextMissing(savedRow);
    } catch (err: any) {
      setStatus("저장 실패: " + (err?.message ?? String(err)), "err");
    } finally {
      saveBtn.disabled = false;
    }
  });

  saveNoneBtn.addEventListener("click", async () => {
    if (!selectedRow) return;
    const slug = selectedRow.dataset.slug!;
    setStatus("저장 중…");
    saveNoneBtn.disabled = true;
    try {
      const res = await fetch("/api/admin/places-coordinates/save", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ slug, none: true }),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data?.error ?? `HTTP ${res.status}`);
      const savedRow = selectedRow;
      updateRowAfterNone(savedRow);
      recountSummary();
      advanceToNextMissing(savedRow);
    } catch (err: any) {
      setStatus("저장 실패: " + (err?.message ?? String(err)), "err");
    } finally {
      saveNoneBtn.disabled = false;
    }
  });

  removeBtn.addEventListener("click", async () => {
    if (!selectedRow) return;
    const slug = selectedRow.dataset.slug!;
    if (!confirm("좌표 설정을 삭제(미입력 상태로)하시겠습니까?")) return;
    setStatus("삭제 중…");
    removeBtn.disabled = true;
    try {
      const res = await fetch("/api/admin/places-coordinates/delete", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ slug }),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data?.error ?? `HTTP ${res.status}`);
      updateRowAfterDelete(selectedRow);
      recountSummary();
      latInput.value = "";
      lngInput.value = "";
      dCurrent.textContent = "— (미입력)";
      removeBtn.hidden = true;
      linkOsm.hidden = true;
      mapGoto(null, null);
      setStatus("좌표 설정을 삭제했습니다.", "ok");
    } catch (err: any) {
      setStatus("삭제 실패: " + (err?.message ?? String(err)), "err");
    } finally {
      removeBtn.disabled = false;
    }
  });
</script>

<style>
  h1 { margin: 0 0 0.4rem; }
  .meta { color: var(--color-muted); margin: 0 0 1rem; font-size: 0.9rem; }
  .meta code { font-size: 0.85em; }

  .summary {
    display: flex;
    gap: 1.5rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--color-rule);
    border-radius: 6px;
    background: var(--color-surface-2);
    margin: 0 0 1rem;
    font-size: 0.9rem;
  }

  .app {
    display: grid;
    grid-template-columns: minmax(280px, 360px) 1fr;
    gap: 1rem;
    align-items: start;
  }
  @media (max-width: 720px) {
    .app { grid-template-columns: 1fr; }
  }

  .list {
    border: 1px solid var(--color-rule);
    border-radius: 6px;
    background: var(--color-surface-2);
    overflow: hidden;
  }
  .search {
    width: 100%;
    box-sizing: border-box;
    padding: 0.55rem 0.7rem;
    border: 0;
    border-bottom: 1px solid var(--color-rule);
    background: transparent;
    color: var(--color-fg);
    font: inherit;
    outline: none;
  }
  .search:focus { background: var(--color-surface-1, var(--color-surface-2)); }

  #rows {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 70vh;
    overflow-y: auto;
  }
  .row { border-bottom: 1px solid var(--color-rule); }
  .row:last-child { border-bottom: 0; }
  .row-btn {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.5rem;
    align-items: center;
    width: 100%;
    padding: 0.5rem 0.7rem;
    border: 0;
    background: transparent;
    color: var(--color-fg);
    text-align: left;
    font: inherit;
    cursor: pointer;
  }
  .row-btn:hover { background: var(--color-primary-bg, rgba(0,0,0,0.04)); }
  .row.selected .row-btn {
    background: var(--color-primary-bg, rgba(0,0,0,0.06));
    box-shadow: inset 3px 0 0 var(--color-primary);
  }
  .ind {
    display: inline-block;
    width: 1.1em;
    text-align: center;
    font-weight: 600;
    font-size: 0.85em;
  }
  .ind-num { color: var(--color-primary); }
  .ind-none { color: var(--color-secondary, #888); }
  .ind-missing { color: var(--color-muted); opacity: 0.5; }
  .row-main { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .row-name { font-size: 0.92rem; }
  .row-hanja { font-size: 0.75rem; color: var(--color-muted); }
  .row-region {
    font-size: 0.72rem;
    color: var(--color-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 9em;
  }

  .detail {
    border: 1px solid var(--color-rule);
    border-radius: 6px;
    padding: 1rem 1.2rem;
    min-height: 12rem;
  }
  .empty { color: var(--color-muted); margin: 0; }
  .card-head h2 { margin: 0; font-size: 1.1rem; }
  .card-meta {
    margin: 0.25rem 0 0;
    color: var(--color-muted);
    font-size: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
  }
  .dot { color: var(--color-muted); }
  .status { font-size: 0.78rem; padding: 0.05rem 0.4rem; border-radius: 3px; background: var(--color-rule); }

  .current {
    margin: 0.9rem 0 0.6rem;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .current .label { font-size: 0.8rem; color: var(--color-muted); }
  .current .value { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.9rem; }

  .map-wrap { margin: 0.6rem 0 0.9rem; }
  .map-hint { margin: 0.4rem 0 0; font-size: 0.78rem; color: var(--color-muted); }

  .inputs {
