---
import Base from "../../../layouts/Base.astro";
import AdminGate from "../../../components/AdminGate.astro";
import ArchiveCandidateQueue from "../../../components/admin/ArchiveCandidateQueue.svelte";
import Snackbar from "../../../components/admin/Snackbar.svelte";
---

<Base title="archive 후보 검수 큐 — admin">
  <AdminGate>
    <header class="hd">
      <p class="crumb"><a href="/admin/">← admin 인덱스</a></p>
      <h1>Archive 후보 검수 큐</h1>
      <p class="meta">
        세 경전 본문에서 자동 추출된 미등록 인물·장소 후보를 검수·등록합니다. 적용 시
        <code>content/people/&lt;slug&gt;.md</code> · <code>content/places/&lt;slug&gt;.md</code>
        가 minimal stub 으로 생성되고 큐에서 제거됩니다. 한자만 추출된 후보는 slug·name 을
        한글로 다듬어 적용하세요. 로컬 dev 모드에서만 동작합니다.
      </p>
    </header>

    <ArchiveCandidateQueue client:load />
    <Snackbar client:load />
  </AdminGate>
</Base>

<style>
  .hd {
    margin-bottom: 1rem;
  }
  .hd h1 {
    margin: 0.2rem 0 0.3rem;
  }
  .crumb {
    margin: 0;
    font-size: 0.85rem;
  }
  .meta {
    color: var(--color-muted);
    font-size: 0.88rem;
    margin: 0;
    line-height: 1.5;
  }
  .meta code {
    background: var(--color-surface-2);
    padding: 0.05rem 0.3rem;
    border-radius: 3px;
    font-size: 0.82rem;
  }
</style>
