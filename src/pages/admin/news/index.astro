---
/**
 * /admin/news/ — 운영자(level>=4) 뉴스 작성·수정·삭제 도구.
 *
 * AdminGate 가 운영자만 본 UI 를 보이게 가린다(워커도 모든 admin endpoint 에서
 * level 체크 다시 한다 — 이중 보호).
 */
import Base from "../../../layouts/Base.astro";
import AdminGate from "../../../components/AdminGate.astro";
import NewsAdmin from "../../../components/admin/NewsAdmin.svelte";
---

<Base title="소식 관리 — jsbooks">
  <AdminGate redirect="/login">
    <header class="admin-header">
      <h1>소식 관리</h1>
      <p class="hint">새 글 작성·수정·삭제, 드래프트 토글. 발행 글은 즉시 사이트에 노출됩니다.</p>
    </header>
    <NewsAdmin client:only="svelte" />
  </AdminGate>
</Base>

<style>
  .admin-header {
    margin-bottom: 1.2rem;
  }
  .admin-header h1 {
    margin: 0 0 0.25rem;
    font-size: 1.45rem;
  }
  .hint {
    margin: 0;
    color: var(--color-muted, #8a807a);
    font-size: 0.9rem;
  }
</style>
