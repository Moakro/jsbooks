---
/**
 * /소식/ — 발행된 글 목록. D1 (`/api/news`) 에서 client-fetch.
 * 카테고리·안내문 제거. 운영자 '+ 새 글' 은 우측상단 absolute (NewsAdminBar).
 */
import Base from "../../layouts/Base.astro";
import NewsList from "../../components/news/NewsList.svelte";
import NewsAdminBar from "../../components/news/NewsAdminBar.svelte";
---

<Base title="소식 — jsbooks">
  <header class="news-header">
    <h1>소식</h1>
    <NewsAdminBar client:load />
  </header>

  <NewsList client:load />
</Base>

<style>
  .news-header {
    position: relative;
    margin-bottom: 1.2rem;
  }
  .news-header h1 {
    margin: 0;
    font-size: 1.6rem;
  }
</style>
