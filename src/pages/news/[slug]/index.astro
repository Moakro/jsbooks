---
/**
 * /news/:slug/ — 단일 뉴스 상세. slug 가 D1 동적 키이므로 SSR(prerender=false).
 * 페이지 자체는 빈 shell 만 렌더하고 본문·메타·운영자 액션은 `<NewsArticle>` 가
 * client-fetch 한다(404 도 클라이언트에서 표시).
 */
export const prerender = false;

import Base from "../../../layouts/Base.astro";
import NewsArticle from "../../../components/news/NewsArticle.svelte";

const { slug } = Astro.params as { slug: string };
---

<Base title="소식 — jsbooks">
  <NewsArticle slug={slug} client:load />
</Base>
