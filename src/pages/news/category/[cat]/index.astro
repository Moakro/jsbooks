---
/**
 * /news/category/:cat/ — 카테고리별 뉴스 목록. 4개 카테고리 정적 path.
 * 본문은 D1 (`/api/news?category=:cat`) 에서 client-fetch.
 */
import Base from "../../../../layouts/Base.astro";
import NewsList from "../../../../components/news/NewsList.svelte";
import {
  NEWS_CATEGORIES,
  categoryLabel,
  type NewsCategory,
} from "../../../../lib/news";

export async function getStaticPaths() {
  return NEWS_CATEGORIES.map((cat) => ({ params: { cat } }));
}

const { cat } = Astro.params;
const label = categoryLabel(cat as NewsCategory);
---

<Base title={`${label} — 뉴스 — jsbooks`}>
  <header class="news-header">
    <h1>뉴스 · {label}</h1>
    <nav class="cat-nav" aria-label="뉴스 카테고리">
      <a href="/news/">전체</a>
      {NEWS_CATEGORIES.map((c) => (
        <a href={`/news/category/${c}/`} class:list={[{ active: c === cat }]}>{categoryLabel(c)}</a>
      ))}
    </nav>
  </header>

  <NewsList category={cat} client:load />
</Base>

<style>
  .news-header {
    margin-bottom: 1.4rem;
  }
  .news-header h1 {
    margin: 0 0 0.5rem;
    font-size: 1.6rem;
  }
  .cat-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .cat-nav a {
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--color-rule, #e8dfd9);
    border-radius: 999px;
    font-size: 0.82rem;
    color: var(--color-fg, #1f1c1a);
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .cat-nav a:hover,
  .cat-nav a.active {
    border-color: var(--color-primary, #a8352a);
    color: var(--color-primary, #a8352a);
  }
  .cat-nav a.active {
    background: color-mix(in srgb, var(--color-primary, #a8352a) 10%, transparent);
    font-weight: 600;
  }
</style>
