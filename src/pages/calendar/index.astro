---
import Base from "../../layouts/Base.astro";
import Calendar from "../../components/calendar/Calendar.svelte";
import { getDayInfo } from "../../lib/date";

// 빌드 시점 기준 — 클라이언트에서 URL query(?y=&m=) 우선으로 덮어씀.
const now = new Date();
const year = now.getFullYear();
const month = now.getMonth() + 1;
const info = getDayInfo(now);
---

<Base title={`달력 — ${year}년 ${month}월`}>
  <header class="cal-header">
    <h1>달력</h1>
    <p class="cal-jeolgi">
      이번 절기 <strong>{info.jeolgi.current.name}</strong>
      <span class="hanja">({info.jeolgi.current.hanja})</span>
      · 다음 절기 <strong>{info.jeolgi.next.name}</strong>까지 {info.jeolgi.daysUntil}일
    </p>
  </header>

  <Calendar client:load initialYear={year} initialMonth={month} />

  <p class="cal-note">절기는 평균일 기준으로 ±1일 오차가 있을 수 있습니다.</p>
</Base>

<style>
  .cal-header {
    margin-bottom: 1.1rem;
  }
  .cal-header h1 {
    margin: 0 0 0.3rem;
    font-size: 1.6rem;
  }
  .cal-jeolgi {
    margin: 0;
    font-size: 0.88rem;
    color: var(--color-fg, #1f1c1a);
  }
  .cal-jeolgi .hanja {
    color: var(--color-muted, #8a807a);
  }
  .cal-note {
    margin-top: 0.8rem;
    font-size: 0.78rem;
    color: var(--color-muted, #8a807a);
  }
</style>
